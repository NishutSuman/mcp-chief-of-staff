# Copy to .streamlit/secrets.toml (local) or paste into
# Streamlit Community Cloud -> App -> Settings -> Secrets (cloud).
# Never commit the real secrets.toml — it is gitignored.

# Google Gemini API key (free): https://aistudio.google.com/app/apikey
# You can also paste this directly into the app's UI instead of setting it here.
GEMINI_API_KEY = "your_gemini_api_key_here"
